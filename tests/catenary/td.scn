//$n Tor doświadczalny
//$d SCENERIA EKSPERYMENTALNA - NIE DO NORMALNEJ GRY
//$d =================================================
//$d Prosta sceneria do nauki, testów i eksperymentów.
//$d Shift+1-4 ustawianie przebiegu Shift+0 reset przebiegu.
//$d Shift+5-7 zmiana napięcia podstacji zasilającej.
//$d Shift+8-9 ręczna kontrola przejazdu.
//$i td.jpg
//Ra: nowe mapowanie podsypki nie wymaga skalowania tekstury
//$l Techniczne

/***********************\
I        POGODA         I
\***********************/

sky skydome_clouds.t3d endsky
atmo 0 0 0 1000 2000 0 0 0 endatmo
time 10:30 06:30 19:00 endtime

include td/drogi.scm end
