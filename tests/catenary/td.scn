include rezonator.inc tdo_rez 0.396851 0.0 36.1112 180 none none end

//Ra: zasilacz sieci trakcyjnej, podłączony tylko do jednego przęsła
include pkp/odsekc20.inc pwr1 20 0 0 0.0 pkp/odsekc20 3600 0.01 4500 end

//Ra: odłącznik sekcyjny - definiuje tylko prąd odcięcia sekcji przez podstację lub kabinę sekcyjną
node -1 0 pwr01 tractionpowersource 0 0 0 3400 0 0.01 2000 1.0 3 60.0 section end

/***********************\
I        EVENTY         I
\***********************/
event keyctrl00 multiple 0.1 none stacja1_a_s1 stacja1_j-s1 stacja1_k-s1 endevent
event stacja1_j-s1 multiple 0.1 none stacja1_j_s1 stacja1_psj1_sp1 stacja1_psj2_sp1 endevent
event stacja1_k-s1 multiple 0.1 none stacja1_k_s1 stacja1_psk1_sp1 stacja1_psk2_sp1 endevent
event keyctrl01 multiple 0.1 none zwr01+ stacja1_a_s5 endevent
event keyctrl02 multiple 0.1 none zwr01- stacja1_a_s13 endevent
event keyctrl03 multiple 0.1 none zwr02+ stacja1_j-s1 stacja1_k_s2 stacja1_psk1_sp2 stacja1_psk2_sp2 endevent
event keyctrl04 multiple 0.1 none zwr02- stacja1_j_s10 stacja1_psj1_sp4 stacja1_psj2_sp4 stacja1_k-s1 endevent

//Ra: eventy zmiany napięcia w sieci trakcyjnej
event keyctrl05 voltage 0.1 pwr1 2400 endevent
event keyctrl06 voltage 0.1 pwr1 3000 endevent
event keyctrl07 voltage 0.1 pwr1 3600 endevent
event keyctrl08 multiple 0.1 none przej_1_zamykaj przej_2_zamykaj endevent
event keyctrl09 multiple 0.1 none przej_1_otwieraj przej_2_otwieraj endevent

//node 2000 0 bramki model 0 0 0 0 siec_trakcyjna/bramka_p-p-19-7.t3d  none endmodel 
node 2000 0 bramki model 0 0 0 0 siec_trakcyjna/polbramki.t3d  siec_trakcyjna/bramki_new2 endmodel 
//node 2000 0 bramki1 model 20 0 20 0 siec_trakcyjna/przesla.t3d  siec_trakcyjna/bramki_new2 endmodel 
/***********************\
I         SKŁAD         I
\***********************/

FirstInit

trainset rozklad start 0.0 0.0
//$o Skład wygaszony pod wjazdowym.
node -1 0 EP07-424 dynamic PKP\303E_V1 303E-EP-TV-424-HIST 303E-EP-TV 0 headdriver 35.WH25 0 enddynamic
node -1 0 51512071081-6 dynamic PKP\11XA_V2 bdnu_2071081-6 111AW-SPOT 0 nobody 115 0 enddynamic
node -1 0 bdhpumn_50512608068-6 dynamic pkp\bdhpumn_v3 bdhpumn_50512608068-6 BDHPUMN_TAPICERKA_1 0 nobody 115 0 enddynamic
node -1 0 bdhpumn_50512608011-6 dynamic pkp\bdhpumn_v3 bdhpumn_50512608011-6 BDHPUMN_NG_1 0 passenger 0 0 enddynamic
endtrainset


trainset td/rozklad tdo_n1734 0.0 0.1
//$o Skład gotowy na żeberku.
endtrainset

trainset 50 d3 0.0 30
//$o Samochód
endtrainset
