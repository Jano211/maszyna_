// include zs2cby.inc stacja2_a 1202.5 -0.2 1200 0 a end
// include ss3czbi.inc stacja2_b 1197.5 -0.2 1455 180 b end
// include ts1py_shp.inc stacja2_toa 1173.5 0 1723 -20 toa end
include ts2zpy_shp.inc stacja1_toa 63.4 0 -237 150 toa end
