include ps3pzbii.inc stacja1_psc2 2.7 0 1062 0 c-1m end
// include ip/pkp/d1.inc none 1200 0 1170 5 0 5 end
include ip/pkp/w4n.inc stacja1#1 2.7 0 529 3 -1 1 1 1 end
include ip/pkp/w4n.inc stacja1#2 7.3 0.5 529 1 3 3 2 2 end
include ip/pkp/w4n.inc stacja1#3 -1.8 0.5 1200 183 -3 3 1 2 end
